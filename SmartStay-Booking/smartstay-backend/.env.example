# Development settings for Docker Compose. Keep your existing .env when updating.
APP_ENV=development
MONGODB_URI=mongodb://mongodb:27017/?replicaSet=rs0
MONGODB_DB_NAME=smart_stay_tourism
REDIS_URL=redis://redis:6379/0
MEDIA_BACKEND=local
# These public development placeholders must be replaced before deployment.
JWT_SECRET=dev-jwt-secret-key-change-in-production-32chars
REFRESH_TOKEN_SECRET=dev-refresh-secret-key-change-in-prod-32chars
SECRET_KEY=dev-fernet-and-app-secret-key-change-in-prod
# Run python scripts/configure_phase2.py for strong keys and first super-admin.
SUPERADMIN_BOOTSTRAP_MODE=disabled
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=
TRUSTED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443,http://localhost:8001,http://127.0.0.1:8001,http://localhost:4173,http://127.0.0.1:4173
PII_CLEANUP_INTERVAL_SECONDS=3600

# Phase 3: managed media is private until its POI is published.
# Leave CONTENT_MEDIA_DIR unset to use the Docker content_media volume.
# CONTENT_MEDIA_DIR=/app/runtime_data/content-media
CONTENT_CLEANUP_INTERVAL_SECONDS=30
CONTENT_MEDIA_GRACE_SECONDS=86400
CONTENT_QUERY_TIMEOUT_MS=10000
MAX_AUDIO_SIZE_BYTES=26214400

# Translation: Google first, MyMemory fallback; no API key is required.
# Modes: auto, google, mymemory. Existing .env files can omit these defaults.
TRANSLATION_PROVIDER=auto
TRANSLATION_CACHE_TTL_SECONDS=2592000
TRANSLATION_GOOGLE_COOLDOWN_SECONDS=900
# Optional: your own valid contact email for MyMemory's larger free quota.
MYMEMORY_EMAIL=

# Optional S3-compatible media storage (MEDIA_BACKEND=s3).
# For a local Docker S3 server, run: python scripts/configure_local_s3.py
# The helper generates credentials and enables docker-compose.s3.yml.
S3_ENDPOINT_URL=
S3_BUCKET=smartstay-media
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SESSION_TOKEN=
S3_ADDRESSING_STYLE=path
S3_HEALTH_PREFIX=_healthchecks
S3_CONNECT_TIMEOUT_SECONDS=2
S3_READ_TIMEOUT_SECONDS=2
S3_HEALTH_CACHE_TTL_SECONDS=30
S3_CA_BUNDLE=
